GATEWAY_API_KEY=replace-me
AUTH_MODE=api_key
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid,profile,email,groups
OIDC_SESSION_SECRET=replace-with-random-secret
OIDC_SESSION_TTL_SECONDS=3600
OIDC_SESSION_MAX_LIFETIME_SECONDS=86400
OIDC_COOKIE_NAME=phase_lock_session
OIDC_COOKIE_SECURE=true
AUTH_AUDIT_LOG_PATH=
AUTH_AUDIT_LOG_MAX_BYTES=10485760
AUTH_AUDIT_LOG_BACKUP_COUNT=5
OIDC_REQUIRED_GROUPS=
OIDC_GROUP_ROLE_MAP=
POLICY_MODE=builtin
OPA_URL=
POLICY_BUNDLE_PATH=
POLICY_DEFAULT_DECISION=deny
POLICY_DECISION_LOG_PATH=
POLICY_DECISION_LOG_MAX_BYTES=10485760
POLICY_DECISION_LOG_BACKUP_COUNT=5
STATE_BACKEND=memory
STATE_REDIS_URLS=
TENANT_RUNTIME_CACHE_ENABLED=false
AIRGAPPED_MODE=false
ALLOW_OUTBOUND_NETWORK=true
AIRGAP_ALLOWED_HOSTS=
HA_MODE_ENABLED=false
DETERMINISTIC_MODE=true
DRIFT_ENGINE_SEED=7
DRIFT_SPIKE_THRESHOLD=0.80
DRIFT_BREAKER_TRIP_COUNT=3
MAX_METRIC_WINDOW=4096
MAX_COMPUTE_STEPS=50000
ALLOW_INSECURE_NO_AUTH=false
OIDC_TRUST_PROXY_HEADERS=false
# HMAC secret your front end uses to sign X-User-Id/X-User-Groups (X-User-Signature). Keep it separate from GATEWAY_API_KEY.
USER_ID_SIGNING_SECRET=replace-with-random-secret
ALLOW_UNSIGNED_USER_ID=false
MAX_TENANTS=1000
BASELINE_WINDOWS=5
BASELINE_TTL_SECONDS=2592000
PUBLIC_BASE_URL=http://127.0.0.1:8000
